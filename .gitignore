# Python 캐시 및 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
.env
venv/
ENV/

# 데이터베이스
*.db
server/assy_manager.db
**/archives/*
**/raws/*
**/*.csv

# IDE 설정
.vscode/
.idea/
*.swp
*.swo

# 프로젝트 작업 공간 및 로그
.gemini/
.bevel/
agent_workspace/tasks/
