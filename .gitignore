# Python 캐시 및 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
.env
venv/
ENV/

# 데이터베이스
*.db
server/assy_manager.db
**/archives/*
**/raws/*
**/*.csv

# IDE 설정
.vscode/
.idea/
*.swp
*.swo

# 프로젝트 작업 공간 및 로그
.gemini/
.bevel/
agent_workspace/tasks/
!agent_workspace/reports/
agent_workspace/*
_archive/*
/.codex_tmp/
/.test_tmp/
/.pnpm-store/
/.pytest_cache/
/.claude/settings.local.json

# OS 생성 파일
Thumbs.db
Desktop.ini
.DS_Store

# 로그 파일
*.log
*.log.*
server/*.log

# 빌드 결과물
client/build/
client/dist/
client/*.spec
# 🔴 이 하나는 «결과물이 아니라 소스»입니다. PyInstaller 가 인자 없이 만들어 내는 spec 은
#    위 규칙대로 무시하되, 손으로 관리하는 이것은 추적합니다 — desktop_wrapper.py 의 주석 셋이
#    이 파일을 «정본으로 인용»하고 있고(datas=[] · console=False · onedir), 인용되는 파일이
#    추적되지 않으면 그 주석이 가리키는 곳이 언제든 사라집니다.
!client/AssyManagerClient.spec

# 운영 환경 고유 설정 및 인제션 워크스페이스
server/config/*
!server/config/sample/
server/config/sample/*
!server/config/sample/*.sample
# 라이브 온톨로지 셋업은 «환경 자산»이라 추적하지 않는다 — 그 환경의 표·컬럼을 가리킨다.
# 다만 README는 「샘플을 복사해 만든다」를 말하는 유일한 곳이라 지나가야 한다.
# 🔴 위 규칙(`server/config/*`)이 ontology 디렉터리를 통째로 덮으면 git이 그 안으로 내려가지
# 않아 아래 예외가 «아무 효과도 없다». 그래서 디렉터리를 먼저 되살리고 내용물을 무시한다.
!server/config/ontology/
server/config/ontology/*
!server/config/ontology/README.md
server/mappers/*
!server/mappers/*.sample
# A Ledger v2 mapper is not an operator's local script. It is the half of the declaration
# config cannot express, and `ledger.implementations` imports it BY THIS PREFIX to decide
# what a config may name -- so a checkout without it has a config it cannot run. The same
# boundary that decides what executes therefore decides what is tracked.
# Two were force-added before this line existed; the third would have been too.
!server/mappers/ledger_v2_*.py
# void 파이프라인 파서 하나만 예외로 둔다 — 그 스크립트가 voids.json 인제션의 실제
# 구현이고, 운영과 개발이 같은 것을 봐야 한다.
# 🔴 `server/ingestion_workspace/`처럼 디렉터리를 통째로 무시하면 git이 그 안으로 내려가지
# 않아 하위 예외가 «아무 효과도 없다». 그래서 각 층의 «내용물»(`/*`)을 무시하고 지나갈
# 경로만 되살리는 형태로 쓴다.
server/ingestion_workspace/*
!server/ingestion_workspace/void/
server/ingestion_workspace/void/*
!server/ingestion_workspace/void/scripts/
server/ingestion_workspace/void/scripts/*
!server/ingestion_workspace/void/scripts/voids_json.py
server/database/virtual_graph.json
.claude/doc_sync_pending

# 격리 개발 환경 (server/scripts/dev_env/devenv.py bootstrap 생성물 — 운영 자산의 복사본)
# 반드시 루트 고정(/) — 앵커가 없으면 같은 이름의 하위 디렉터리(server/scripts/dev_env/,
# 즉 도구 소스 자체)까지 조용히 무시된다.
/dev_env/

# config 백업 스냅샷 — server/config/가 일부러 git 밖인데 그 사본이 들어오면 같은 이유가 무너진다
server/config_backup_*/

# 픽스처 정답(오라클)은 `**/*.csv` 예외 — 이건 원시 데이터가 아니라 **채점 기준**이다.
# 저장소 밖에 두면 「그때 그 정답」이 사라져 다음 라운드와 비교가 끊긴다.
!server/trace_fixture_oracle/*.csv

# A crashed probe run can leave a whole-file copy beside its subject. tests/lib/probe.mjs
# deletes them and sweeps stale ones, but a stray copy in src/ must never be committable.
*.__probe__.*.js
