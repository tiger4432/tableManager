{
  "$comment": "LEDGER SQL COMPILE -- the seam between the translator (Python, `ledger.sql_translate.event_results`: what the stored ledger holds) and the walk's compile (SQL, `ledger.sql_translate.compile_world`: what engine=virtual reads). Both are scored against the atoms written here BY HAND from the declaration and the rows, and against each other (raw refs included). Times are compared as instants (UTC). A case with `left_out` scores the compile's refusal only. Rows go through the write door, so a key's padding is stripped before either side reads it (`crud.normalize_stored_text`) - the compile reads a text key as the cell.",
  "version": 1,
  "seam": {
    "python": "server/ledger/sql_translate.py :: event_results (the translator's judges)",
    "sql": "server/ledger/sql_translate.py :: compile_world (legs) - read by ledger_api.ledger_subgraph.VirtualEvidenceLookup"
  },
  "table": {"step": "string", "at": "string"},
  "cases": [
    {
      "name": "keys: a number spelled as the ledger spells it, a constant, and a reference whose when holds",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul"}},
      "references": {"die@1": [{"edge": "in_container@1", "to": {"entity": "wafer@1", "keys": {"wafer": "mat_id"}},
                                "from": {"when": {"mat_type": "Wafer"}}}]},
      "mappings": {"seen": {"predicate": "inspected@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "die@1", "keys": {
          "mat_id": {"kind": "column", "column": "dt_job"}, "x": {"kind": "column", "column": "dt_x"},
          "y": {"kind": "column", "column": "dt_y"}, "mat_type": {"kind": "constant", "value": "Wafer"}}}}}},
      "rows": [{"dt_job": "W1", "dt_x": 9.0, "dt_y": 9.5, "at": "2026-10-01 09:30"},
               {"dt_job": "W2", "dt_x": 1, "dt_y": -2, "at": "2026-10-01T09:30:00+02:00"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "inspected", {"type": "die", "keys": {"mat_id": "W1", "mat_type": "Wafer", "x": "9", "y": "9.5"}}, "2026-10-01T00:30:00+00:00", null],
        ["die", {"mat_id": "W1", "mat_type": "Wafer", "x": "9", "y": "9.5"}, "in_container", {"type": "wafer", "keys": {"wafer": "W1"}}, "2026-10-01T00:30:00+00:00", "ingested"],
        ["wafer", {"wafer": "W2"}, "inspected", {"type": "die", "keys": {"mat_id": "W2", "mat_type": "Wafer", "x": "1", "y": "-2"}}, "2026-10-01T07:30:00+00:00", null],
        ["die", {"mat_id": "W2", "mat_type": "Wafer", "x": "1", "y": "-2"}, "in_container", {"type": "wafer", "keys": {"wafer": "W2"}}, "2026-10-01T07:30:00+00:00", "ingested"]
      ]
    },
    {
      "name": "a reference whose when does not hold says nothing",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul"}},
      "references": {"die@1": [{"edge": "in_container@1", "to": {"entity": "wafer@1", "keys": {"wafer": "mat_id"}},
                                "from": {"when": {"mat_type": "Wafer"}}}]},
      "mappings": {"seen": {"predicate": "inspected@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "die@1", "keys": {
          "mat_id": {"kind": "column", "column": "dt_job"}, "x": {"kind": "column", "column": "dt_x"},
          "y": {"kind": "column", "column": "dt_y"}, "mat_type": {"kind": "constant", "value": "DT"}}}}}},
      "rows": [{"dt_job": "W1", "dt_x": 3, "dt_y": 4, "at": "2026-10-01 09:30"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "inspected", {"type": "die", "keys": {"mat_id": "W1", "mat_type": "DT", "x": "3", "y": "4"}}, "2026-10-01T00:30:00+00:00", null]
      ]
    },
    {
      "name": "an optional qualifier left out when its cell is empty; a blank key and an unreadable time leave their rows",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul"}},
      "mappings": {"made": {"predicate": "processed_with@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "recipe@1", "keys": {"recipe": {"kind": "column", "column": "hold"}}},
        "step": {"kind": "column", "column": "step"}}}},
      "rows": [{"dt_job": "W1", "hold": "R1", "step": "S1", "at": "2026-10-01 09:30"},
               {"dt_job": "W1", "hold": "R2", "at": "2026-10-01 10:00"},
               {"dt_job": "W3", "hold": "R3", "step": "S3", "at": "soon"},
               {"hold": "R4", "step": "S4", "at": "2026-10-01 11:00"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R1"}, "qualifiers": {"step": "S1"}}, "2026-10-01T00:30:00+00:00", null],
        ["wafer", {"wafer": "W1"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R2"}}, "2026-10-01T01:00:00+00:00", null]
      ]
    },
    {
      "name": "a row named by two columns - its raw ref",
      "read": {"order_by": ["hold", "dt_x"], "cursor": {"columns": ["hold", "dt_x"]}, "identity": ["hold", "dt_x"],
               "occurred_at": {"column": "at", "timezone": "Asia/Seoul"}},
      "mappings": {"made": {"predicate": "processed_with@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "recipe@1", "keys": {"recipe": {"kind": "column", "column": "hold"}}}}}},
      "rows": [{"dt_job": "W1", "hold": "R\"1", "at": "2026-10-01 09:30"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R\"1"}}, "2026-10-01T00:30:00+00:00", null]
      ],
      "rows_named": [["hc_official:{\"dt_x\":100.0,\"hold\":\"R\\\"1\"}"]]
    },
    {
      "name": "a row named by a number column - a float as Python writes it, a whole one with .0",
      "read": {"order_by": ["dt_x"], "cursor": {"columns": ["dt_x"]}, "identity": ["dt_x"],
               "occurred_at": {"column": "at", "timezone": "Asia/Seoul"}},
      "mappings": {"made": {"predicate": "processed_with@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "recipe@1", "keys": {"recipe": {"kind": "column", "column": "hold"}}}}}},
      "rows": [{"dt_job": "W1", "dt_x": 9.0, "hold": "R1", "at": "2026-10-01 09:30"},
               {"dt_job": "W2", "dt_x": 0.25, "hold": "R2", "at": "2026-10-01 09:30"},
               {"dt_job": "W3", "dt_x": -3, "hold": "R3", "at": "2026-10-01 09:30"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R1"}}, "2026-10-01T00:30:00+00:00", null],
        ["wafer", {"wafer": "W2"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R2"}}, "2026-10-01T00:30:00+00:00", null],
        ["wafer", {"wafer": "W3"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R3"}}, "2026-10-01T00:30:00+00:00", null]
      ],
      "rows_named": [["hc_official:{\"dt_x\":9.0}"], ["hc_official:{\"dt_x\":0.25}"], ["hc_official:{\"dt_x\":-3.0}"]]
    },
    {
      "name": "a sentence said by its when - a blank cell is \"\" - and a row taken out by a value",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul"}, "exclude_when": [{"when": {"note": "skip"}}]},
      "mappings": {
        "plain": {"predicate": "processed_with@1", "when": {"step": ""}, "bind": {
          "occurred_at": {"kind": "column", "column": "at"},
          "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
          "target": {"kind": "entity", "entity_type": "recipe@1", "keys": {"recipe": {"kind": "column", "column": "hold"}}}}},
        "dt": {"predicate": "processed_with@1", "when": {"step": "DT"}, "bind": {
          "occurred_at": {"kind": "column", "column": "at"},
          "subject": {"kind": "entity", "entity_type": "dtwafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
          "target": {"kind": "entity", "entity_type": "recipe@1", "keys": {"recipe": {"kind": "column", "column": "hold"}}}}}},
      "rows": [{"dt_job": "W1", "hold": "R1", "at": "2026-10-01 09:30"},
               {"dt_job": "W2", "hold": "R2", "step": "DT", "at": "2026-10-01 09:30"},
               {"dt_job": "W3", "hold": "R3", "step": "X", "at": "2026-10-01 09:30"},
               {"dt_job": "W4", "hold": "R4", "note": "skip", "at": "2026-10-01 09:30"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R1"}}, "2026-10-01T00:30:00+00:00", null],
        ["dtwafer", {"wafer": "W2"}, "processed_with", {"type": "recipe", "keys": {"recipe": "R2"}}, "2026-10-01T00:30:00+00:00", null]
      ]
    }
  ]
}
