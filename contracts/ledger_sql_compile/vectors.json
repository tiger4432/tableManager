{
  "$comment": "LEDGER SQL COMPILE -- the seam between the translator (Python, `ledger.sql_translate.event_results`: what the stored ledger holds) and the walk's compile (SQL, `ledger.sql_translate.compile_world`: what engine=virtual reads). Both are scored against the atoms written here BY HAND from the declaration and the rows, and against each other. The compile's atom names its row by its row id, the translator's by `read.order_by` (owner 11-07: the read is SQL alone, no byte parity with the stored record). Times are compared as instants (UTC); `at` is text read by its declared format, which the walk's SQL orders and bounds by (`time_format.text_order`) - a case with `walk` reads the walk of its subjects newest first at each cap (from `since`, the current facts of `one`) - a row the SQL lets through that says nothing would take a place under the cap - a row whose text does not match the format counted unreadable. A case with `left_out` scores the compile's refusal only; `key` the table's row key (a time column that is a key keeps its text). Rows go through the write door, so a key's padding is stripped before either side reads it (`crud.normalize_stored_text`) - the compile reads a text key as the cell.",
  "version": 1,
  "seam": {
    "python": "server/ledger/sql_translate.py :: event_results (the translator's judges)",
    "sql": "server/ledger/sql_translate.py :: compile_world (legs) - read by ledger_api.ledger_subgraph.VirtualEvidenceLookup"
  },
  "table": {"step": "string", "at": "string", "seen": "datetime"},
  "cases": [
    {
      "name": "keys: a number spelled as the ledger spells it, a constant, and a reference whose when holds",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul", "format": "%Y-%m-%d %H:%M"}},
      "references": {"die@1": [{"edge": "in_container@1", "to": {"entity": "wafer@1", "keys": {"wafer": "mat_id"}},
                                "from": {"when": {"mat_type": "Wafer"}}}]},
      "mappings": {"seen": {"predicate": "inspected@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "die@1", "keys": {
          "mat_id": {"kind": "column", "column": "dt_job"}, "x": {"kind": "column", "column": "dt_x"},
          "y": {"kind": "column", "column": "dt_y"}, "mat_type": {"kind": "constant", "value": "Wafer"}}}}}},
      "rows": [{"dt_job": "W1", "dt_x": 9.0, "dt_y": 9.5, "at": "2026-10-01 09:30"},
               {"dt_job": "W2", "dt_x": 1, "dt_y": -2, "at": "2026-10-01 16:30"}],
      "expected": [
        ["wafer", {"wafer": "W1"}, "inspected", {"type": "die", "keys": {"mat_id": "W1", "mat_type": "Wafer", "x": "9", "y": "9.5"}}, "2026-10-01T00:30:00+00:00", null],
        ["die", {"mat_id": "W1", "mat_type": "Wafer", "x": "9", "y": "9.5"}, "in_container", {"type": "wafer", "keys": {"wafer": "W1"}}, "2026-10-01T00:30:00+00:00", "ingested"],
        ["wafer", {"wafer": "W2"}, "inspected", {"type": "die", "keys": {"mat_id": "W2", "mat_type": "Wafer", "x": "1", "y": "-2"}}, "2026-10-01T07:30:00+00:00", null],
        ["die", {"mat_id": "W2", "mat_type": "Wafer", "x": "1", "y": "-2"}, "in_container", {"type": "wafer", "keys": {"wafer": "W2"}}, "2026-10-01T07:30:00+00:00", "ingested"]
      ]
    },
    {
      "name": "a reference whose when does not hold says nothing",
      "read": {"occurred_at": {"column": "at", "timezone": "Asia/Seoul", "format": "%Y-%m-%d %H:%M"}},
      "references": {"die@1": [{"edge": "in_container@1", "to": {"entity": "wafer@1", "keys": {"wafer": "mat_id"}},
                                "from": {"when": {"mat_type": "Wafer"}}}]},
      "mappings": {"seen": {"predicate": "inspected@1", "bind": {
        "occurred_at": {"kind": "column", "column": "at"},
        "subject": {"kind": "entity", "entity_type": "wafer@1", "keys": {"wafer": {"kind": "column", "column": "dt_job"}}},
        "target": {"kind": "entity", "entity_type": "die@1", "keys": {
          "mat_id": {"kind": "column", "column": "dt_job"}, "x": {"kind": "column", "column": "dt_x"},
