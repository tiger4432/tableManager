{
  "skeleton_version": 1,
  "note": "The shape of a ledger config, as a document. The form is generated from this; the validator still decides what is good. server/tests/test_ledger_skeleton.py counts the drift between the two and both counts must be 0.",
  "defs": {
    "binding": {
      "kind": "record",
      "fields": [
        {
          "key": "attributes",
          "required": false,
          "label": "속성 (이 역할만)",
          "help": "한 문장이 같은 타입을 두 역할로 쓸 때만. 없으면 소스 것을 물려받는다.",
          "when": {
            "field": "kind",
            "is": "entity"
          },
          "node": {
            "kind": "map",
            "keyed_by": "name",
            "member": "속성",
            "of": {
              "use": "binding"
            }
          }
        },
        {
          "key": "kind",
          "required": true,
          "label": "바인딩",
          "node": {
            "kind": "leaf",
            "hint": "choice",
            "list": "binding_kinds"
          }
        },
        {
          "key": "column",
          "required": true,
          "when": {
            "field": "kind",
            "is": "column"
          },
          "node": {
            "kind": "leaf",
            "hint": "free"
          }
        },
        {
          "key": "timezone",
          "required": false,
          "label": "시간대 (timestamp 값일 때)",
          "help": "이 컬럼의 «naive한» 읽기가 어느 시간대인지. 글자에 오프셋이 있으면 그쪽이 이깁니다. 값 타입이 timestamp 인 역할에는 «필수»입니다 - 없으면 번역에서 모든 원자가 거절됩니다. 예: Asia/Seoul",
          "when": {
            "field": "kind",
            "is": "column"
          }
        },
        {
          "key": "value",
          "required": true,
          "when": {
            "field": "kind",
            "is": "constant"
          },
          "node": {
            "kind": "leaf",
            "hint": "free"
          }
        },
        {
          "key": "entity_type",
          "required": true,
          "when": {
            "field": "kind",
            "is": "entity"
          },
          "node": {
            "kind": "leaf",
            "hint": "ref",
            "section": "entities"
          }
        },
        {
          "key": "keys",
          "required": true,
          "when": {
            "field": "kind",
            "is": "entity"
          },
          "node": {
            "kind": "map",
            "keyed_by": "name",
            "member": "식별키",
            "of": {
              "use": "identity_binding"
            }
          }
        }
      ]
    },
    "identity_binding": {
      "kind": "record",
      "note": "An entity's identity key. The same record as `binding` with the `entity` kind removed -- `_validate_binding` refuses a nested entity there, so offering it recommends a value that can only be refused. Still ONE layer, and still a binding record.",
      "fields": [
        {
          "key": "kind",
          "required": true,
          "label": "바인딩",
          "node": {
            "kind": "leaf",
            "hint": "choice",
            "list": "identity_binding_kinds"
          }
        },
        {
          "key": "column",
          "required": true,
          "when": {
            "field": "kind",
            "is": "column"
          },
          "node": {
            "kind": "leaf",
            "hint": "free"
          }
        },
        {
          "key": "value",
          "required": true,
          "when": {
            "field": "kind",
            "is": "constant"
          },
          "node": {
            "kind": "leaf",
            "hint": "free"
          }
        }
      ]
    }
  },
