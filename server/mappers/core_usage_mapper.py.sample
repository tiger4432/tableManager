"""dt_inventory core equations -> scoped physical-core usage-map replacements."""
from __future__ import annotations

import json
from collections import defaultdict

import dt_frame_transform
import map_meta_registrar
import notation_norm


SOURCE_NAME = "chain_ingestion"
UPDATED_BY = "chain_core_usage"
_EQUATION_FIELDS = ("core_x_base", "core_x_sign", "core_x_offset",
                    "core_y_base", "core_y_sign", "core_y_offset")


def _value(payload, key):
    cell = (payload.get("data") or {}).get(key)
    return cell.get("value") if isinstance(cell, dict) else None


def _nonblank(value):
    return value is not None and str(value).strip() != ""


def _canonical_wafer(value):
    """Read equivalent wafer-ID spellings as one physical usage-map identity."""
    if not _nonblank(value):
        return None
    return notation_norm.fold_notation(str(value).strip(), notation_norm.DEFAULT_RULES)


def _apply_core_equations(x, y, equation):
    raw = {"X": int(x), "Y": int(y)}
    return (
        raw[equation["core_x_base"]] * int(equation["core_x_sign"]) + int(equation["core_x_offset"]),
        raw[equation["core_y_base"]] * int(equation["core_y_sign"]) + int(equation["core_y_offset"]),
    )


def _usage_batches(rows, equations_by_job, target_table="core_usage_map"):
    """Aggregate already-fetched dt_log rows into one replace batch per core map."""
    cells = {}
    for row in rows:
        job_id = getattr(row, "dt_job", None)
        equation = equations_by_job.get(str(job_id))
        wafer = _canonical_wafer(getattr(row, "core_wafer", None))
        if not equation or not _nonblank(wafer):
            continue
        try:
            x, y = _apply_core_equations(getattr(row, "core_x"), getattr(row, "core_y"), equation)
        except (KeyError, TypeError, ValueError):
            continue
        key = (str(wafer), x, y)
        cell = cells.setdefault(key, {"jobs": set(), "lot_slots": set()})
        cell["jobs"].add(str(job_id))
        lot, slot = getattr(row, "core_lot", None), getattr(row, "core_slot", None)
        if _nonblank(lot) and _nonblank(slot):
            cell["lot_slots"].add((str(lot), str(slot)))

    by_map = defaultdict(list)
    for (wafer, x, y), usage in sorted(cells.items()):
        lot_slots = sorted(usage["lot_slots"])
        lot, slot = lot_slots[0] if len(lot_slots) == 1 else (None, None)
        by_map[wafer].append({"updates": {
            "core_wafer": wafer, "core_lot": lot, "core_slot": slot, "core_x": x, "core_y": y,
            "used_count": len(usage["jobs"]),
            "used_dt_jobs": json.dumps(sorted(usage["jobs"]), ensure_ascii=False),
            "core_lot_slots": json.dumps(lot_slots, ensure_ascii=False),
        }, "source_name": SOURCE_NAME, "updated_by": UPDATED_BY})
    return [{"target_table": target_table, "replace_map": True,
             "scope": {"core_wafer": wafer}, "updates": updates}
            for wafer, updates in by_map.items()]


def _standard_frame(value):
    """Return the standard core-map metadata encoded on an inventory row."""
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except (TypeError, ValueError):
            return None
    try:
        return dt_frame_transform.standard_meta(value)
    except ValueError:
        return None


def _usage_metadata_updates(wafers, frames_by_job, target_table):
    """Register one fixed-standard metadata record per physical wafer."""
    updates = []
    for wafer, job_ids in sorted(wafers.items()):
        metadata = next((frames_by_job[job_id] for job_id in sorted(job_ids)
                         if job_id in frames_by_job), None)
        if metadata is None:
            continue
        updates.append({
            "business_key_val": map_meta_registrar.meta_business_key(target_table, wafer),
            "updates": {
                "target_table": target_table,
                "map_id": wafer,
                "grid_metadata": json.dumps(metadata, ensure_ascii=False, sort_keys=True),
            },
            "source_name": SOURCE_NAME,
            "updated_by": "core_usage_map_metadata",
        })
    return updates


def build_core_usage_map_batches(db, payloads, rule=None):
    """Refresh all physical-core maps touched by jobs whose core equation changed."""
    from database import models

    rule = rule or {}
    source = models.DYNAMIC_TABLES.get(rule.get("source_table", "dt_log"))
    inventory = models.DYNAMIC_TABLES.get(rule.get("inventory_table", "dt_inventory"))
    if source is None or inventory is None:
        raise ValueError("core usage source or inventory table is not initialized")
    jobs = {str(_value(payload, "dt_job")) for payload in payloads or ()
            if _nonblank(_value(payload, "dt_job"))}
    if not jobs:
        return {"batches": []}
    touched = db.query(source).filter(source.dt_job.in_(jobs)).all()
    wafers = sorted({_canonical_wafer(row.core_wafer) for row in touched
                     if _canonical_wafer(row.core_wafer)})
    if not wafers:
        return {"batches": []}
    folded_wafer = notation_norm.fold_notation_sql(source.core_wafer,
                                                    notation_norm.DEFAULT_RULES)
    all_rows = db.query(source).filter(folded_wafer.in_(wafers)).all()
    all_jobs = {str(row.dt_job) for row in all_rows if _nonblank(row.dt_job)}
    equations, frames = {}, {}
    for item in db.query(inventory).filter(inventory.dt_job.in_(all_jobs)).all():
        equation = {field: getattr(item, field, None) for field in _EQUATION_FIELDS}
        frame = _standard_frame(getattr(item, "core_frame", None))
        job_id = str(item.dt_job)
        if all(value is not None for value in equation.values()):
            equations[job_id] = equation
        if frame is not None:
            frames[job_id] = frame

    jobs_by_wafer = defaultdict(set)
    for row in all_rows:
        wafer = _canonical_wafer(row.core_wafer)
        if wafer and _nonblank(row.dt_job):
            jobs_by_wafer[wafer].add(str(row.dt_job))
    approved = {
        wafer: jobs for wafer, jobs in jobs_by_wafer.items()
        if jobs and jobs.issubset(equations)
    }
    approved_rows = [row for row in all_rows
                     if _canonical_wafer(getattr(row, "core_wafer", None)) in approved]
    target_table = rule.get("target_table", "core_usage_map")
    return {
        "map_metadata_updates": _usage_metadata_updates(approved, frames, target_table),
        "batches": _usage_batches(approved_rows, equations, target_table),
    }
