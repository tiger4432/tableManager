      "dt_slot": "string",
      "dt_x": "number",
      "dt_y": "number",
      "bond_eqp": "string",
      "event_time": "string"
    },
    "display_columns": [
      "bond_cell_key",
      "bond_lot",
      "bond_slot",
      "bond_x",
      "bond_y",
      "b_bn",
      "stack_height",
