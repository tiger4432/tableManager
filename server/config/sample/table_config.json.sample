  "dt_core_view": {
    "__comment": "Read-only alignment-review projection of dt_log's core-coordinate payload. It has a distinct map namespace because wafer_map_metadata is keyed by (target_table, map_id): dt_log/dt_job already owns DT-frame metadata and must never be overloaded with a second, core-frame declaration. Rows are keyed by the source DT job plus raw recorded core coordinates; this table is not the canonical core wafer map and is not a production output map.",
    "business_key": "dt_core_view_cell_key",
    "composite_key_source": [
      "dt_job",
      "core_x",
      "core_y"
    ],
    "composite_key_separator": "_",
