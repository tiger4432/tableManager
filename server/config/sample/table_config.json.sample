      "unit",
      "eqp_id",
      "recipe_id",
      "eventtime"
    ]
  },
  "process_param_num": {
    "__comment": "[ledger source] VIEW over process_param, value IS NOT NULL. Split because a NULL in a numeric column becomes NaN in the event frame and NaN is not deterministic JSON - so a source may not bind a column its own rows leave empty. Same predicate as its sibling; only the bound value column differs.",
    "business_key": "param_id",
    "column_types": {
      "param_id": "string",
      "wafer_id": "string",
