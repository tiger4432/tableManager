  "dt_log_transferable": {
    "__comment": "READ-ONLY VIEW: dt_log rows that carry a core_wafer, which is the core die's identity. 6,731 of 34,939 rows have none; the translator RAISES on a missing identity rather than skipping, and `read` has no filter axis, so the exclusion lives here. One condition suffices: the 522 rows without event_time (= product SYNTHETIC) are a subset of those 6,731. Keeps 28,208. Rollback: DROP VIEW dt_log_transferable;",
    "composite_key_source": [
      "dt_job_id",
      "b_wx",
      "b_wy"
    ],
    "composite_key_separator": "|",
    "column_types": {
