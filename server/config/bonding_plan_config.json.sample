{
  "__doc__": "본딩 실험계획(M1) 역할 바인딩 config 샘플. 역할(role)→실테이블 바인딩을 정의한다 — 실 운영 환경에서는 table/columns를 실제 테이블명에 맞게 교체. 역할이 누락되면 해당 역할은 'missing'으로 부분 가동된다(에러 아님). [v2 · 2026-07-26] 맵 모드 소스의 align 선언은 **제거됐다** — 소스 좌표계→canonical(CORE) 좌표계 변환은 두 맵의 wafer_map_metadata 델타에서 유도된다(회전·면·y반전·start·치수·phys 6종 전부). canonical 프레임은 메타가 등록된 첫 맵 모드 역할(total_chips → defect → eds_fail)이다. 계측으로 잰 어긋남도 별도 선언이 아니라 그 맵의 메타에 기록하라. 이 파일에 sources[].align이 남아 있어도 서버는 무시한다 — 삭제하고, 대신 각 맵을 wafer_map_metadata에 등록하라(미등록이면 identity로 붙는다 = 등록 누락 신호). map_metadata는 맵 메타(wafer_map_metadata 관례) 조회 바인딩 — region 클램프와 정렬 유도의 원천이다. [전제 테이블] 여기의 모든 table 값은 table_config.json에 선언돼 있어야 해석된다(미선언 = 그 역할 'missing'). wafer_map_metadata만 제품 소유(table_config.json.sample에 이미 있음)이고, bonding_log·core_defect_map·eds_fail_map·wafer_process는 전부 현장 소유라 표준 스키마가 아니다 — 당신의 실제 테이블명·컬럼명으로 table_config.json에 선언한 뒤 여기 table/columns를 그 이름으로 맞춰라. 체크리스트는 docs/guide/CONFIG_GUIDE.md의 '기능별 필요 테이블 체크리스트' 참조.",
  "core_identity": { "compose": ["lot", "slot"] },
  "map_metadata": {
    "table": "wafer_map_metadata",
    "columns": {
      "target_table": "target_table",
      "map_id": "map_id",
      "grid_metadata": "grid_metadata"
    }
  },
  "sources": {
    "process_history": {
      "table": "wafer_process",
      "columns": {
        "step": "step",
        "eqp": "eqp_id",
        "result": "result",
        "time": "start_time",
        "recipe": "recipe_id",
        "knobs": "knobs",
        "lot": "lot",
        "slot": "slot"
      }
    },
    "defect": {
      "mode": "map",
      "table": "core_defect_map",
      "columns": { "lot": "lot", "slot": "slot", "x": "x", "y": "y", "val": "val" },
      "fail_values": ["D"]
    },
    "eds_fail": {
      "mode": "map",
      "table": "eds_fail_map",
      "columns": { "lot": "lot", "slot": "slot", "x": "x", "y": "y", "val": "val" },
      "fail_values": ["F"]
    },
    "used_chips": {
      "table": "bonding_log",
      "columns": { "lot": "core_lot", "slot": "core_slot", "x": "cx", "y": "cy" }
    },
    "total_chips": {
      "mode": "map",
      "table": "core_defect_map",
      "columns": { "lot": "lot", "slot": "slot", "x": "x", "y": "y" }
    }
  },
  "warnings": { "result_fail_values": ["FAIL"] }
}
