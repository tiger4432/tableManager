{
  "__comment": "M1 bonding plan 역할 바인딩. [2026-08-04 완화] 보조 역할(process_history·defect·eds_fail·used_chips)은 전부 **선택**이다 — 그런 테이블이 없는 사이트는 키를 아예 선언하지 마라(상태 not_declared, 그 감산항 없이 집계, 빠진 종류는 응답 inactive_subtractions가 명시). 선언해 놓고 깨뜨리면(오타·테이블 부재) 종전대로 missing 강등. total_chips는 분모라 계속 필수.",
  "core_identity": {
    "compose": [
      "lot",
      "slot"
    ]
  },
  "map_metadata": {
    "table": "wafer_map_metadata",
    "columns": {
      "target_table": "target_table",
      "map_id": "map_id",
      "grid_metadata": "grid_metadata"
    }
  },
  "sources": {
    "process_history": {
      "table": "wafer_process",
      "columns": {
        "step": "step",
        "eqp": "eqp_id",
        "result": "result",
        "time": "start_time",
        "recipe": "recipe_id",
        "knobs": "knobs",
        "lot": "lot",
        "slot": "slot"
      }
    },
    "defect": {
      "mode": "map",
      "table": "core_defect_map",
      "columns": {
        "lot": "lot",
        "slot": "slot",
        "x": "x",
        "y": "y",
        "val": "val"
      },
      "fail_values": [
        "D"
      ]
    },
    "eds_fail": {
      "mode": "map",
      "table": "eds_fail_map",
      "columns": {
        "lot": "lot",
        "slot": "slot",
        "x": "x",
        "y": "y",
        "val": "val"
      },
      "fail_values": [
        "F"
      ]
    },
    "used_chips": {
      "table": "bonding_log",
      "columns": {
        "lot": "core_lot",
        "slot": "core_slot",
        "x": "cx",
        "y": "cy"
      }
    },
    "total_chips": {
      "mode": "map",
      "table": "core_defect_map",
      "columns": {
        "lot": "lot",
        "slot": "slot",
        "x": "x",
        "y": "y"
      }
    }
  },
  "warnings": {
    "result_fail_values": [
      "FAIL"
    ]
  }
}
