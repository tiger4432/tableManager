{
  "manifest_version": 3,
  "name": "Collector",
  "version": "0.1.0",
  "description": "Reads rows from web pages by templates and writes them to product tables.",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel/panel.html" },
  "action": { "default_title": "Collector" },
  "web_accessible_resources": [{ "resources": ["page/*.js", "lib/*.js"], "matches": ["<all_urls>"] }]
}
